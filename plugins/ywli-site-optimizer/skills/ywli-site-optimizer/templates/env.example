# ~/ywli-optimizer/clients/<slug>/.env  (chmod 600, never committed, never pasted into chat)
STAGING_BASIC_AUTH=user:password
GSC_SA_KEY=/home/<user>/ywli-optimizer/secrets/<slug>-gsc.json
BITBUCKET_TOKEN=
CMS_USER=
CMS_PASS=
# Local DDEV only: trust mkcert CA instead of disabling TLS checks where possible
# NODE_EXTRA_CA_CERTS=/home/<user>/.local/share/mkcert/rootCA.pem
# YWLI_INSECURE=1
